SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BROWSER_USER_DATA_DIR=.browser-profile
# Optional: Set executable path to use an existing Google Chrome installation
# BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional: Profile directory inside BROWSER_USER_DATA_DIR (e.g. Default, Profile 1)
# BROWSER_PROFILE_DIRECTORY=Default
BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36
SKIP_STARTUP_LOGINS=false
MAX_REELS_PER_PLATFORM=1000

# TikTok-only yt-dlp discovery (pending jobs); YouTube uses browser only.
YTDLP_BIN=yt-dlp
YTDLP_TIMEOUT_MS=600000

# Rotating HTTP proxy used ONLY for the yt-dlp TikTok profile attempts
# (discovery/ytdlp.js). The tiktokuser: direct attempt after a TikWM
# secUid lookup runs WITHOUT a proxy. Format: http://user:pass@host:port
# COUNTIK_PROXY_URL=

# Optional: paid TikWM API keys for the TikTok secUid fallback
# (discovery/tikwm.js). Comma-separated list, exactly like TIKWMAPI_KEYS
# (split on commas, trim, drop empties, tried in order); a single key
# with no comma works too. Used ONLY after all 5 yt-dlp profile attempts
# fail: GET /user/info resolves the camelCase secUid for one tiktokuser:
# direct attempt. Separate from the shared TIKWMAPI_KEYS — the scraper
# never reads that var. No proxy is used for the TikWM call.
# TIKWMAPI_KEYS_SCRAPER=
