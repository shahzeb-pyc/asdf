# Root Domain & Tenant Configuration
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Public application URL (canonical origin for auth redirects and links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (project: Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://REPLACE_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_WITH_SUPABASE_ANON_KEY"
# Service Role Key for backend administration (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"

# Session Authentication Secret (HMAC-SHA256, minimum 32 chars)
SESSION_SECRET="REPLACE_ME__generate_with_openssl_rand_base64_48"

# Facebook App Credentials: None in process.env (strictly per-workspace BYOC in database)

# Token Encryption Secret Key (256-bit / 32 bytes hex-encoded, exactly 64 characters)
TOKEN_ENCRYPTION_KEY="REPLACE_ME__generate_with_openssl_rand_hex_32"

# Cloudflare R2 Storage (Media Library)
# Note: In development/test, if omitted, MockStorageProvider is used automatically.
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="fbuploadpro-media-dev"
# R2_PUBLIC_URL="https://media.dev.fbuploadpro.com"

# Distributed Rate Limiting (Upstash Redis REST API)
# Required in production (the limiter fails closed without them there).
# UPSTASH_REDIS_REST_URL="https://REPLACE_WITH_UPSTASH_REDIS_REST_URL.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_UPSTASH_REDIS_REST_TOKEN"

# Internal Health Endpoint Token (shared secret for /api/internal/health probes)
# INTERNAL_HEALTH_TOKEN="REPLACE_ME__generate_with_openssl_rand_hex_32"

# Cookie Domain Override (optional; defaults to ".<NEXT_PUBLIC_ROOT_DOMAIN>")
# COOKIE_DOMAIN=".fbuploadpro.com"

# CORS Allowed Origins (comma-separated extra origins allowed by the worker API)
# CORS_ALLOWED_ORIGINS="https://app.fbuploadpro.com"

# Media Downloader Extractor API (optional; enables the social downloader backend)
# DOWNLOADER_EXTRACTOR_API_URL="https://REPLACE_WITH_EXTRACTOR_API_HOST"

# WhatsApp Customer Support (Floating support button across all pages)
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER="+15551234567"
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hi! I need assistance with my FBUploadPro account."

# Registration Availability Guard ("true" to enable, "false" to temporarily pause new signups)
NEXT_PUBLIC_SIGNUPS_ENABLED="true"

# PostHog Analytics + Error Tracking (production only; no sync workflow
# sets these for the web app — POSTHOG_KEY/POSTHOG_HOST are set in the
# Vercel project dashboard for Production/Preview, and the worker reads
# the same names from GitHub Secrets in its deploy workflow. A bare
# region value ("US"/"EU") is accepted; the app normalizes it to the
# real ingest host. Never NEXT_PUBLIC_ — the key reaches the browser
# only as a server-rendered prop.)
# POSTHOG_KEY=
# POSTHOG_HOST=

# Post for Me API key (spec 125) — server-side only. The YouTube connect flow
# calls the provider with this key; the worker uses the same key for YouTube
# publishing (wired there via GitHub Secrets in deploy-worker.yml). Never
# exposed to the browser, never stored in the database.
# POST_FOR_ME_API_KEY=

# NOWPayments crypto checkout (subscription billing) — server-side only,
# values live in Doppler prd, never in code. Deliberately NOT in the
# REQUIRED_ENV_VARS boot check: without these, crypto checkout fails
# loudly with a plain message and bank payments still work, so preview
# and dev do not need real keys. Live crypto cannot be verified
# until all three are supplied.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_PAYOUT_WALLET_ADDRESS= (also configured in the NOWPayments dashboard)

