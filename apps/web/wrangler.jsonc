{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Spec 214: web app on Cloudflare Workers via @opennextjs/cloudflare.
  // `main` and `assets.directory` are generated by
  // `opennextjs-cloudflare build` (.open-next/worker.js + .open-next/assets).
  // Env vars and secrets are NEVER set here: required + optional vars come
  // from Doppler prd via the deploy path (wrangler secret put / dashboard
  // Variables and Secrets), and NEXT_PUBLIC_* vars must be present at
  // BUILD time (inlined into the client bundle), not just at runtime.
  "name": "fbuploadpro-web",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.open-next/worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.open-next/assets"
  }
}
