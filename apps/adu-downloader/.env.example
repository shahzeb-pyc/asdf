SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ADU_BUFFER_BUCKET=fbuploadpro-adu-buffer
# Public base URL of the buffer bucket (same value as the web app's
# R2_PUBLIC_URL). Required: the publisher fetches the buffer object by
# this URL, and the worker intake only picks reels with a media_url set.
R2_PUBLIC_URL=
ADU_DOWNLOADER_IDLE_WAIT_SECONDS=60
ADU_DOWNLOADER_CONCURRENCY=30
ADU_DOWNLOADER_ATTEMPT_RETRIES=4
ADU_DOWNLOADER_STALE_MINUTES=40
# Seconds to wait for in-flight downloads before topping up claims (default 20)
# ADU_DOWNLOADER_IN_FLIGHT_POLL_SECONDS=20
# Log files (default: downloader/logs/). WARNING+ also go to adu-downloader.error.log
# ADU_DOWNLOADER_LOG_DIR=logs
# ADU_DOWNLOADER_LOG_MAX_BYTES=10485760
# ADU_DOWNLOADER_LOG_BACKUP_COUNT=5
# Per-file aria2 connections (default 4). Lower = fewer sockets at high concurrency.
ADU_ARIA2_MAX_CONNECTION=4
ADU_ARIA2_SPLIT=4
# R2 upload read chunk size in bytes (default 8MB). Bounds RAM per active upload.
ADU_R2_UPLOAD_CHUNK_BYTES=8388608
# Optional proxies (omit to download without proxies)
# RESIDENTIAL_PROXY — YouTube full yt-dlp
# DATACENTER_PROXY — Instagram metadata only; TikTok/Facebook full yt-dlp
# ADU_DOWNLOADER_JS_RUNTIME=node  # yt-dlp EJS for YouTube (default node; use node:/path if needed)
# Supabase RPC retries on transient network errors (default 5 attempts, 1s base backoff)
# ADU_DOWNLOADER_RPC_RETRIES=5
# ADU_DOWNLOADER_RPC_BACKOFF_SECONDS=1
# Local cache dir keyed by source reel_id (default: downloader/cache/)
# ADU_DOWNLOADER_CACHE_DIR=cache
RESIDENTIAL_PROXY=
DATACENTER_PROXY=
