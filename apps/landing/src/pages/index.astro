---
import Layout from '../layouts/Layout.astro';

const signup = 'https://app.fbuploadpro.com/signup';
const signin = 'https://app.fbuploadpro.com/login';
---

<Layout
  title="FBUploadPro — Your Accounts, posting themselves — 100% in the cloud"
  description="Schedule posts across Facebook, Instagram, TikTok, YouTube, Threads, and X — they go live while you sleep, even when your laptop is closed."
>
  <div class="page-shell bg-page px-2 py-2 sm:px-4 sm:py-4">
    <div class="hero-card overflow-hidden rounded-[28px] bg-white shadow-[0_20px_60px_rgba(17,17,17,0.12)]">
      {/* ===== TOPBAR — pill bar, like the screenshot ===== */}
      <header class="anim-enter anim-d0 px-3 pt-3 sm:px-8 sm:pt-4">
        <div class="mx-auto flex w-fit max-w-full items-center gap-6 rounded-full border border-line bg-white px-3 py-1.5 shadow-[0_8px_24px_rgba(17,17,17,0.08)] sm:px-5 lg:gap-12">
          <a href="#" class="inline-flex min-h-10 shrink-0 items-center gap-2 text-sm font-bold tracking-tight no-underline sm:text-base" aria-label="FBUploadPro home">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="32" height="32" fill="none" role="img" aria-label="FBUploadPro" class="h-6 w-6 shrink-0 sm:h-7 sm:w-7"><path d="M24 11L12 23L17 28L20 25V51L28 45V23H45L53 15H28L24 11Z" fill="#fcd535" /><path d="M24 11L12 23L13.2 24.2L24 13.4L28 17.4H50.6L53 15H28L24 11Z" fill="#ffffff" fill-opacity="0.35" /><path d="M32 30H48L40 38H32V30Z" fill="#f0b90b" /><path d="M32 43H41L35 49H32V43Z" fill="#766018" /></svg><span>FBUploadPro</span>
          </a>
          <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
            <a href="#" class="inline-flex min-h-10 items-center text-base font-medium text-ink-sub no-underline hover:text-ink">Features</a>
            <a href="#" class="inline-flex min-h-10 items-center text-base font-medium text-ink-sub no-underline hover:text-ink">How it works</a>
            <a href="#" class="inline-flex min-h-10 items-center text-base font-medium text-ink-sub no-underline hover:text-ink">Platforms</a>
          </nav>
          <div class="flex shrink-0 items-center gap-2 sm:gap-4">
            <a href={signin} class="hidden min-h-10 items-center text-sm font-medium no-underline min-[375px]:inline-flex sm:text-base">Sign in</a>
            <a href={signup} class="inline-flex min-h-10 items-center rounded-full bg-ink px-3 text-sm font-semibold text-white no-underline sm:px-4 sm:text-base">Get started</a>
          </div>
        </div>
      </header>

      {/* ===== HERO ONLY ===== */}
      <main>
        <section class="relative overflow-hidden px-5 pt-16 pb-16 text-center sm:pt-20" aria-label="Hero">
          <h1 class="anim-enter anim-d1 mx-auto mb-6 max-w-4xl text-[40px] leading-[1.05] font-bold tracking-tight sm:text-5xl md:text-[64px] lg:text-[72px]">
            <span class="block">Your Accounts, posting <span class="whitespace-nowrap">themselves —</span></span>
            <span class="hero-highlight mt-1 inline-block">100% in the cloud</span>
          </h1>
          <p class="anim-enter anim-d2 mx-auto mb-8 max-w-2xl text-base leading-relaxed text-ink-sub sm:text-lg">
            Schedule posts across Facebook, Instagram, TikTok, YouTube, Threads, and X — they go live while you sleep, even when your <span class="whitespace-nowrap">laptop is closed.</span><br />Manage FBUploadPro using Muse or any AI agent.
          </p>
          <div class="anim-enter anim-d3 flex justify-center">
            <a href={signup} class="inline-flex min-h-11 items-center gap-2 rounded-full bg-ink px-7 text-base font-semibold text-white no-underline">
              Get started
              <span aria-hidden="true">→</span>
            </a>
          </div>

          {/* Mobile platform tiles — phones only (hidden at lg and up).
              Compact diamond grid, two rows of three, so phones are not
              left tile-less while the desktop perspective stage stays
              hidden below lg. Each tile is a small 2D diamond (a square
              rotated 45deg) with its logo as a SEPARATE upright layer
              centred over it (translate(-50%,-50%) only, no rotate, no
              tilt) — the logo itself is never tilted or flattened.
              Same six Simple Icons logos as the desktop stage; the
              Instagram gradient uses its own id (ig-grad-m) so it does
              not duplicate the desktop stage's ig-grad. Middle-column
              tiles sit 8px lower for a slight stagger. */}
          <div class="anim-enter anim-d4 mx-auto mt-10 grid max-w-[280px] grid-cols-3 justify-items-center gap-3 lg:hidden" aria-hidden="true">
            <span class="mob-float mob-float-a relative block h-[72px] w-[72px]">
              <span class="absolute left-1/2 top-1/2 h-[52px] w-[52px] -translate-x-1/2 -translate-y-1/2 rotate-45 rounded-[14px] border border-line bg-white shadow-[0_8px_20px_rgba(17,17,17,0.12)]"></span>
              <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="#1877f2" role="img" aria-label="Facebook"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
            </span>
            <span class="mob-float mob-float-b relative block h-[72px] w-[72px] translate-y-2">
              <span class="absolute left-1/2 top-1/2 h-[52px] w-[52px] -translate-x-1/2 -translate-y-1/2 rotate-45 rounded-[14px] border border-line bg-white shadow-[0_8px_20px_rgba(17,17,17,0.12)]"></span>
              <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" role="img" aria-label="Instagram"><defs><linearGradient id="ig-grad-m" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="25%" stop-color="#e6683c"/><stop offset="50%" stop-color="#dc2743"/><stop offset="75%" stop-color="#cc2366"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs><path fill="url(#ig-grad-m)" d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg>
            </span>
            <span class="mob-float mob-float-c relative block h-[72px] w-[72px]">
              <span class="absolute left-1/2 top-1/2 h-[52px] w-[52px] -translate-x-1/2 -translate-y-1/2 rotate-45 rounded-[14px] border border-line bg-white shadow-[0_8px_20px_rgba(17,17,17,0.12)]"></span>
              <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="#000000" role="img" aria-label="Threads"><path d="M18.263 11.097c-.03-3.486-1.92-5.586-5.111-5.586-2.13 0-3.922.963-4.863 2.499l2.062 1.438c.535-.843 1.272-1.543 2.628-1.543 1.528 0 2.318.85 2.544 2.431a15 15 0 0 0-2.236-.173c-4.125 0-6.068 1.867-6.068 4.336s1.943 3.99 4.804 3.99c3.139 0 5.013-2.115 5.781-4.735.798.361 1.348 1.204 1.348 2.47 0 3.387-3.907 5.232-7.22 5.232-4.885 0-8.077-3.207-8.077-8.424 0-6.392 4.223-10.487 9.9-10.487 3.808 0 5.69 1.671 6.97 3.914l2.108-1.475C21.44 2.078 18.331 0 13.663 0 6.227 0 1.168 5.277 1.168 12.934c0 7 4.953 11.066 10.856 11.066 4.878 0 9.809-2.846 9.809-7.716 0-2.545-1.46-4.231-3.569-5.187m-6.33 4.855c-1.077 0-2.026-.512-2.026-1.453 0-1.483 1.822-1.934 3.606-1.934.678 0 1.34.045 1.927.173-.422 1.927-1.671 3.215-3.508 3.214Z"/></svg>
            </span>
            <span class="mob-float mob-float-a relative block h-[72px] w-[72px]">
              <span class="absolute left-1/2 top-1/2 h-[52px] w-[52px] -translate-x-1/2 -translate-y-1/2 rotate-45 rounded-[14px] border border-line bg-white shadow-[0_8px_20px_rgba(17,17,17,0.12)]"></span>
              <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="#000000" role="img" aria-label="TikTok"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </span>
            <span class="mob-float mob-float-b relative block h-[72px] w-[72px] translate-y-2">
              <span class="absolute left-1/2 top-1/2 h-[52px] w-[52px] -translate-x-1/2 -translate-y-1/2 rotate-45 rounded-[14px] border border-line bg-white shadow-[0_8px_20px_rgba(17,17,17,0.12)]"></span>
              <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="#ff0000" role="img" aria-label="YouTube"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </span>
            <span class="mob-float mob-float-c relative block h-[72px] w-[72px]">
              <span class="absolute left-1/2 top-1/2 h-[52px] w-[52px] -translate-x-1/2 -translate-y-1/2 rotate-45 rounded-[14px] border border-line bg-white shadow-[0_8px_20px_rgba(17,17,17,0.12)]"></span>
              <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="#000000" role="img" aria-label="X"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
            </span>
          </div>

          {/* Isometric platform tiles — desktop only, visual only.
              Perspective floor, like the reference original: white diamond tiles
              (rotateX + rotateZ) at varying depths, overlapping, edge tiles
              partially cut. Each logo is a SEPARATE layer, NOT a child of its
              tilted tile: the wrapper holds two siblings — the diamond tile
              div (isometric transform) and the logo SVG, absolutely centred
              over it with transform translate(-50%,-50%) only, no rotate,
              no rotateX — so the logo renders upright, undistorted, on top
              of its diamond, like the original. Bobbing lives on the outer
              wrapper (translateY only) so it never tilts or flattens
              anything. Logos: Simple Icons v16.36.0 paths, copied
              faithfully (see global.css comment). Instagram shape is filled
              with the official Instagram gradient; all others use their
              brand colour. */}
          <div class="anim-enter anim-d4 pointer-events-none relative mx-auto mt-8 hidden h-[280px] max-w-[1100px] lg:block" aria-hidden="true">
            {/* Facebook — front-left, partially cut at left edge */}
            <span class="iso-bob iso-bob-a absolute bottom-[84px] left-[-14px] z-[3] h-[118px] w-[118px]">
              <span class="iso-tile absolute inset-0 rounded-[24px] border border-line bg-white"></span>
              <svg class="iso-logo-flat" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="52" height="52" fill="#1877f2" role="img" aria-label="Facebook"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
            </span>
            {/* Instagram — front, larger, lower */}
            <span class="iso-bob iso-bob-b absolute bottom-[18px] left-[17%] z-[5] h-[138px] w-[138px]">
              <span class="iso-tile absolute inset-0 rounded-[26px] border border-line bg-white"></span>
              <svg class="iso-logo-flat" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="60" height="60" role="img" aria-label="Instagram"><defs><linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="25%" stop-color="#e6683c"/><stop offset="50%" stop-color="#dc2743"/><stop offset="75%" stop-color="#cc2366"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs><path fill="url(#ig-grad)" d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg>
            </span>
            {/* Threads — back, smaller, higher */}
