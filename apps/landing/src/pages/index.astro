---
import Layout from '../layouts/Layout.astro';

const signup = 'https://app.fbuploadpro.com/signup';
const signin = 'https://app.fbuploadpro.com/login';
---

<Layout
  title="FBUploadPro — Your Accounts, posting themselves — 100% in the cloud"
  description="Schedule posts across Facebook, Instagram, TikTok, YouTube, Threads, and X — they go live while you sleep, even when your laptop is closed."
>
  <div class="min-h-screen bg-page px-2 py-2 sm:px-4 sm:py-4">
    <div class="mx-auto max-w-[1400px] overflow-hidden rounded-[28px] bg-white shadow-[0_20px_60px_rgba(17,17,17,0.12)]">
      {/* ===== TOPBAR — pill bar, like the screenshot ===== */}
      <header class="px-4 pt-4 sm:px-8 sm:pt-5">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-line bg-white px-4 py-2 shadow-[0_8px_24px_rgba(17,17,17,0.08)] sm:px-5">
          <a href="#" class="inline-flex min-h-11 shrink-0 items-center text-lg font-bold tracking-tight no-underline" aria-label="FBUploadPro home">
            FB<span>Upload</span>Pro
          </a>
          <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
            <a href="#" class="inline-flex min-h-11 items-center text-base font-medium text-ink-sub no-underline hover:text-ink">Features</a>
            <a href="#" class="inline-flex min-h-11 items-center text-base font-medium text-ink-sub no-underline hover:text-ink">How it works</a>
            <a href="#" class="inline-flex min-h-11 items-center text-base font-medium text-ink-sub no-underline hover:text-ink">Platforms</a>
          </nav>
          <div class="flex shrink-0 items-center gap-4">
            <a href={signin} class="hidden min-h-11 items-center text-base font-medium no-underline sm:inline-flex">Sign in</a>
            <a href={signup} class="inline-flex min-h-11 items-center rounded-full bg-ink px-5 text-base font-semibold text-white no-underline">Get started</a>
          </div>
        </div>
      </header>

      {/* ===== HERO ONLY ===== */}
      <main>
        <section class="hero-in relative overflow-hidden px-5 pt-16 pb-16 text-center sm:pt-20" aria-label="Hero">
          <h1 class="mx-auto mb-6 max-w-4xl text-[40px] leading-[1.05] font-bold tracking-tight sm:text-5xl md:text-[64px] lg:text-[72px]">
            <span class="block">Your Accounts, posting themselves —</span>
            <span class="hero-highlight mt-1 inline-block">100% in the cloud</span>
          </h1>
          <p class="mx-auto mb-8 max-w-2xl text-base leading-relaxed text-ink-sub sm:text-lg">
            Schedule posts across Facebook, Instagram, TikTok, YouTube, Threads, and X — they go live while you sleep, even when your laptop is closed.
          </p>
          <div class="flex justify-center">
            <a href={signup} class="inline-flex min-h-11 items-center gap-2 rounded-full bg-ink px-7 text-base font-semibold text-white no-underline">
              Get started
              <span aria-hidden="true">→</span>
            </a>
          </div>

          {/* Floating platform tiles — desktop only, visual only, no names under the tiles.
              One centred row: tight cluster, small stagger via margin-top (not transform,
              so the bobbing animation never drifts tiles apart). */}
          <div class="pointer-events-none mx-auto mt-10 hidden max-w-[760px] items-start justify-center gap-5 lg:flex" aria-hidden="true">
            {/* Facebook — blue f */}
            <span class="float-tile float-tile-a flex h-20 w-20 shrink-0 rotate-[-12deg] items-center justify-center rounded-3xl border border-line bg-white">
              <span class="text-5xl font-bold text-[#1877f2]">f</span>
            </span>
            {/* Instagram — gradient camera outline */}
            <span class="float-tile float-tile-b mt-4 flex h-20 w-20 shrink-0 rotate-[8deg] items-center justify-center rounded-3xl border border-line bg-white">
              <span class="flex h-14 w-14 items-center justify-center rounded-[16px]" style="background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888)">
                <span class="flex h-9 w-9 items-center justify-center rounded-full border-[3px] border-white">
                  <span class="block h-2 w-2 rounded-full bg-white"></span>
                </span>
              </span>
            </span>
            {/* Threads — black @ */}
            <span class="float-tile float-tile-c flex h-20 w-20 shrink-0 rotate-[-6deg] items-center justify-center rounded-3xl border border-line bg-white">
              <span class="text-5xl font-bold text-black">@</span>
            </span>
            {/* TikTok — black musical note */}
            <span class="float-tile float-tile-a mt-4 flex h-20 w-20 shrink-0 rotate-[10deg] items-center justify-center rounded-3xl border border-line bg-white">
              <span class="text-5xl font-bold text-black">♪</span>
            </span>
            {/* YouTube — red play triangle */}
            <span class="float-tile float-tile-b flex h-20 w-20 shrink-0 rotate-[-10deg] items-center justify-center rounded-3xl border border-line bg-white">
              <span class="flex h-12 w-16 items-center justify-center rounded-xl bg-[#ff0000]">
                <span class="text-xl text-white">▶</span>
              </span>
            </span>
            {/* X — black X */}
            <span class="float-tile float-tile-c mt-4 flex h-20 w-20 shrink-0 rotate-[14deg] items-center justify-center rounded-3xl border border-line bg-white">
              <span class="text-5xl font-bold text-black">X</span>
            </span>
          </div>
        </section>
      </main>
    </div>
  </div>
</Layout>
