---
import Layout from '../layouts/Layout.astro';

const platforms = ['Facebook', 'Instagram', 'TikTok', 'YouTube', 'Threads', 'X'];

const queueRows = [
  { initial: 'F', platform: 'Facebook', type: 'Reel', status: 'Scheduled' },
  { initial: 'I', platform: 'Instagram', type: 'Post', status: 'Scheduled' },
  { initial: 'T', platform: 'TikTok', type: 'Reel', status: 'Published' },
  { initial: 'Y', platform: 'YouTube', type: 'Video', status: 'Scheduled' },
];

const steps = [
  { number: '01', title: 'Create', text: 'Create your posts in one place, for every platform at once.' },
  { number: '02', title: 'Schedule', text: 'Drop them in the queue. Each one takes its next posting time.' },
  { number: '03', title: 'Grow', text: 'They publish on time from the cloud, so your pages keep posting — even when you\'re not there.' },
];

const weekDays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const scheduledWeekDays = ['Tue', 'Thu', 'Sat'];
---

<Layout
  title="FBUploadPro — Your pages, posting themselves, 100% on the cloud"
  description="Queue reels and posts for Facebook, Instagram, TikTok, YouTube, Threads, and X once, pick your posting times, and they go live from the cloud, on time, whether your laptop is open or not."
>
  <header class="sticky top-0 z-20 border-b border-line bg-night/80 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4">
      <div class="text-lg font-bold tracking-tight">
        FB<span class="text-gold">Upload</span>Pro
      </div>
      <nav class="hidden items-center gap-8 sm:flex" aria-label="Main">
        <a href="#features" class="inline-flex min-h-11 items-center text-base font-medium no-underline">
          Features
        </a>
        <a href="#how-it-works" class="inline-flex min-h-11 items-center text-base font-medium no-underline">
          How it works
        </a>
      </nav>
      <div class="flex items-center gap-3">
        <a
          href="https://app.fbuploadpro.com/login"
          class="hidden min-h-11 items-center rounded-md border border-line px-4 text-base font-semibold no-underline sm:inline-flex"
        >
          Sign in
        </a>
        <a
          href="https://app.fbuploadpro.com/signup"
          class="inline-flex min-h-11 items-center rounded-md bg-gold px-5 text-base font-semibold text-night no-underline"
        >
          Get started
        </a>
      </div>
    </div>
  </header>

  <main>
    <section class="mx-auto max-w-4xl px-5 pt-16 pb-12 text-center sm:pt-24 sm:pb-16">
      <p class="mb-6 text-sm font-bold tracking-[0.2em] text-gold uppercase">
        CREATE · SCHEDULE · GROW
      </p>
      <h1 class="mb-6 text-[40px] leading-[1.05] font-bold tracking-tight md:text-[64px] lg:text-[72px]">
        Your pages, posting themselves —<br />
        <span class="text-gold">100% on the cloud.</span>
      </h1>
      <p class="mx-auto mb-8 max-w-2xl text-lg text-ink-sub sm:text-xl">
        Queue reels and posts for Facebook, Instagram, TikTok, YouTube, Threads, and X once, pick
        your posting times, and they go live from the cloud, on time, whether your laptop is open
        or not.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="https://app.fbuploadpro.com/signup"
          class="inline-flex min-h-11 w-full items-center justify-center rounded-md bg-gold px-6 text-base font-semibold text-night no-underline sm:w-auto"
        >
          Get started
        </a>
        <a
          href="https://app.fbuploadpro.com/login"
          class="inline-flex min-h-11 w-full items-center justify-center rounded-md border border-line px-6 text-base font-semibold no-underline sm:w-auto"
        >
          Sign in
        </a>
      </div>
    </section>

    <section aria-label="Product illustration" class="relative mx-auto max-w-5xl px-5 pb-8">
      <p class="sr-only">
        Designed illustration of a dashboard with a sidebar, a queue of scheduled and published
        posts, and a calendar strip. Not a screenshot.
      </p>
      <div
        class="absolute inset-x-8 top-8 bottom-0 rounded-3xl bg-gold/15 blur-3xl"
        aria-hidden="true"
      ></div>
      <div class="relative overflow-hidden rounded-2xl border border-line bg-panel shadow-2xl">
        <div class="flex items-center gap-3 border-b border-line bg-night px-4 py-3">
          <div class="flex gap-2" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          </div>
          <p class="m-0 mx-auto rounded-md border border-line bg-panel px-4 py-1 text-sm text-ink-sub">
            app.fbuploadpro.com
          </p>
          <span class="w-16" aria-hidden="true"></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-4">
          <div class="hidden border-r border-line p-4 sm:block" aria-hidden="true">
            <p class="m-0 mb-4 rounded-md bg-gold/15 px-3 py-2 text-base font-semibold text-gold">Queue</p>
            <p class="m-0 mb-2 px-3 py-2 text-base text-ink-sub">Calendar</p>
            <p class="m-0 px-3 py-2 text-base text-ink-sub">Platforms</p>
          </div>
          <div class="p-4 sm:col-span-3 sm:p-6">
            <div class="mb-4 flex items-center justify-between gap-3">
              <p class="m-0 text-base font-semibold">Queue</p>
              <p class="m-0 rounded-full bg-gold/15 px-3 py-1 text-sm font-semibold text-gold">Scheduled</p>
            </div>
            <ul class="m-0 list-none p-0">
              {
                queueRows.map((row) => (
                  <li class="mb-3 flex min-h-11 flex-wrap items-center gap-3 rounded-lg border border-line bg-panel-soft px-4 py-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full border border-line text-sm font-bold" aria-hidden="true">
                      {row.initial}
                    </span>
                    <span class="text-base font-medium">{row.platform}</span>
                    <span class="text-base text-ink-sub">{row.type}</span>
                    <span class="ml-auto text-sm font-medium text-ink-sub">{row.status}</span>
                  </li>
                ))
              }
            </ul>
            <div class="mt-6 border-t border-line pt-4" aria-hidden="true">
              <div class="grid grid-cols-7 gap-1 text-center">
                {weekDays.map((day) => (
                  <div class="py-1">
                    <p class="m-0 text-sm text-ink-sub">{day}</p>
                    <span
                      class={
                        scheduledWeekDays.includes(day)
                          ? 'mx-auto mt-1 block h-2 w-2 rounded-full bg-gold'
                          : 'mx-auto mt-1 block h-2 w-2 rounded-full bg-line'
                      }
                    ></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="mt-6 text-center text-sm text-ink-sub">
        Illustration of the queue and calendar — not a screenshot.
      </p>
    </section>

    <section aria-label="Platforms" class="mx-auto max-w-6xl px-5 py-12 sm:py-16">
      <p class="mb-6 text-center text-sm font-bold tracking-[0.2em] text-ink-sub uppercase">Works with</p>
      <ul class="m-0 flex flex-wrap justify-center gap-x-8 gap-y-3 p-0 list-none">
        {
          platforms.map((platform) => (
            <li class="text-lg font-semibold text-ink-sub">{platform}</li>
          ))
        }
      </ul>
    </section>

    <section id="features" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16 sm:py-24" aria-labelledby="features-heading">
      <p class="mb-4 text-sm font-bold tracking-[0.2em] text-gold uppercase">Features</p>
      <h2 id="features-heading" class="mb-8 text-4xl font-bold tracking-tight sm:mb-12 sm:text-5xl">Features</h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-6">
        <article class="rounded-2xl border border-line bg-panel p-6 sm:p-8 md:col-span-4">
          <h3 class="mb-2 text-2xl font-semibold">One queue for every platform.</h3>
          <p class="m-0 mb-6 text-base text-ink-sub">
            Connect each account once, then run everything from one place. No switching apps to post
            the same thing six times.
          </p>
          <div class="flex flex-wrap gap-2" aria-hidden="true">
            {
              platforms.map((platform) => (
                <span class="rounded-md border border-line bg-panel-soft px-3 py-2 text-sm font-medium text-ink-sub">
                  {platform}
                </span>
              ))
            }
          </div>
        </article>
        <article class="rounded-2xl border border-line bg-panel p-6 sm:p-8 md:col-span-2">
          <h3 class="mb-2 text-2xl font-semibold">It publishes while you're offline.</h3>
          <p class="m-0 mb-6 text-base text-ink-sub">
            Your posts don't wait for you. Once they're queued, the cloud publishes them at the time
            you picked — laptop closed, phone off.
          </p>
          <div class="flex items-end gap-3" aria-hidden="true">
            <span class="flex h-16 w-24 items-center justify-center rounded-md border border-line bg-panel-soft text-sm text-ink-sub">
              Laptop
            </span>
            <span class="flex h-12 w-8 items-center justify-center rounded-md border border-line bg-panel-soft text-xs text-ink-sub">
              Phone
            </span>
          </div>
        </article>
        <article class="rounded-2xl border border-line bg-panel p-6 sm:p-8 md:col-span-2">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#f0b90b" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <rect x="5" y="11" width="14" height="9" rx="1" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
          <h3 class="mt-4 mb-2 text-2xl font-semibold">Your accounts stay yours.</h3>
          <p class="m-0 text-base text-ink-sub">
            You sign in on Facebook, Instagram, and the rest themselves. We never ask for your
            passwords, and we never see them.
          </p>
        </article>
        <article class="rounded-2xl border border-line bg-panel p-6 sm:p-8 md:col-span-4">
          <h3 class="mb-2 text-2xl font-semibold">Pick your times once.</h3>
          <p class="m-0 mb-6 text-base text-ink-sub">
            Set posting times for each page once. Every post you queue takes the next open time, in
            order — no picking a time for every post.
          </p>
          <div class="flex flex-wrap items-center gap-2 text-sm" aria-hidden="true">
            <span class="rounded-md border border-line bg-panel-soft px-3 py-2 text-ink-sub">Scheduled</span>
            <span class="text-ink-sub">→</span>
            <span class="rounded-md border border-line bg-panel-soft px-3 py-2 text-ink-sub">Cloud</span>
            <span class="text-ink-sub">→</span>
            <span class="rounded-md bg-gold/15 px-3 py-2 font-semibold text-gold">Published</span>
          </div>
        </article>
      </div>
    </section>

    <section id="how-it-works" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16 sm:py-24" aria-labelledby="how-it-works-heading">
      <p class="mb-4 text-sm font-bold tracking-[0.2em] text-gold uppercase">How it works</p>
      <h2 id="how-it-works-heading" class="mb-8 text-4xl font-bold tracking-tight sm:mb-12 sm:text-5xl">How it works</h2>
      <div class="mb-8 hidden h-px bg-line md:block" aria-hidden="true"></div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          steps.map((step) => (
            <article>
              <p class="m-0 mb-4 text-5xl font-bold text-ink-sub" aria-hidden="true">{step.number}</p>
              <h3 class="mb-2 text-2xl font-semibold">{step.title}</h3>
              <p class="m-0 text-base text-ink-sub">{step.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-5 py-16 text-center sm:py-24">
      <h2 class="mb-8 text-4xl leading-tight font-bold tracking-tight sm:text-5xl">
        Start posting every day, without posting every day.
      </h2>
      <a
        href="https://app.fbuploadpro.com/signup"
        class="inline-flex min-h-11 w-full items-center justify-center rounded-md bg-gold px-6 text-base font-semibold text-night no-underline sm:w-auto"
      >
        Get started
      </a>
      <p class="m-0 mt-8 text-base text-ink-sub">
        No passwords shared. You sign in on each platform itself.
      </p>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-8 text-base text-ink-sub">
      <span>FBUploadPro</span>
      <nav class="flex gap-4" aria-label="Footer">
        <a href="#" class="inline-flex min-h-11 items-center no-underline hover:underline">Privacy</a>
        <a href="#" class="inline-flex min-h-11 items-center no-underline hover:underline">Terms</a>
      </nav>
    </div>
  </footer>
</Layout>
