  <!-- Motion: one GSAP system, bundled from npm packages. Free
       scrolling, smoothed by Lenis: wheel, touch, keyboard and
       scrollbar all move freely through as many sections as the
       visitor wants. Every scroll reveal plays forward on the way
       down and genuinely reverses on the way back up. All motion
       uses from-tweens, so if this module ever fails to load, every
       element stays at its fully visible base state and the page
       still scrolls natively. With reduced motion preferred, this
       whole module stays off and the page is plain native scroll. -->
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Lenis from 'lenis';

    gsap.registerPlugin(ScrollTrigger);

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      initMotion();
    }

    function initMotion() {
      /* Lenis smooth scroll, wired into GSAP the standard way.
         Lerp 0.1 is gentle smoothing; touch keeps its native
         momentum, Lenis only smooths wheel input. */
      var lenis = new Lenis({ lerp: 0.1, smoothWheel: true, syncTouch: false });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(function (time) { lenis.raf(time * 1000); });
      gsap.ticker.lagSmoothing(0);

      /* Topbar: animated in with the hero, then hides while
         scrolling down and returns while scrolling up, always
         visible at the very top. Driven by Lenis scroll position,
         with a native scroll fallback for phone touch scrolling. */
      var topbar = document.getElementById('site-topbar');
      var lastScroll = 0;
      var topbarHidden = false;
      function setTopbar(hidden) {
        if (hidden === topbarHidden || !topbar) return;
        topbarHidden = hidden;
        gsap.to(topbar, {
          yPercent: hidden ? -160 : 0,
          opacity: hidden ? 0 : 1,
          duration: 0.35,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      }
      lenis.on('scroll', function (e) {
        var y = e.scroll;
        if (y <= 0) setTopbar(false);
        else if (y > lastScroll && y > 72) setTopbar(true);
        else if (y < lastScroll) setTopbar(false);
        lastScroll = y;
      });
      /* Native scroll fallback for the topbar: with syncTouch
         false, Lenis does not reliably emit scroll during native
         phone touch scrolling, so the topbar would stay visible
         on scroll down. Same direction logic, its own last
         position, same guarded setTopbar — the two listeners are
         idempotent and never fight. A listener, not animation:
         all topbar motion stays in the GSAP tween above. */
      var lastNativeScroll = 0;
      window.addEventListener('scroll', function () {
        var y = window.scrollY || window.pageYOffset || 0;
        if (y <= 0) setTopbar(false);
        else if (y > lastNativeScroll && y > 72) setTopbar(true);
        else if (y < lastNativeScroll) setTopbar(false);
        lastNativeScroll = y;
      }, { passive: true });

      /* Word splitter: wraps each word in a mask > inner pair so
         words rise from below their mask in a cascade. <br> stays
         in place, and words inside a nowrap span stay inside it.
         Runs only inside this module, so a failed load leaves the
         original text untouched and visible. */
      function splitWords(root) {
        var words = [];
        function walk(node) {
          var children = Array.prototype.slice.call(node.childNodes);
          children.forEach(function (child) {
            if (child.nodeType === 3) {
              var parts = child.textContent.split(/(\s+)/);
              parts.forEach(function (part) {
                if (!part) return;
                if (/^\s+$/.test(part)) {
                  node.insertBefore(document.createTextNode(part), child);
                } else {
                  var mask = document.createElement('span');
                  mask.className = 'word-mask';
                  var inner = document.createElement('span');
                  inner.className = 'word-inner';
                  inner.textContent = part;
                  mask.appendChild(inner);
                  node.insertBefore(mask, child);
                  words.push(inner);
                }
              });
              node.removeChild(child);
            } else if (child.nodeType === 1 && child.tagName !== 'BR') {
              walk(child);
            }
          });
        }
        if (root) walk(root);
        return words;
      }
      var heroWords = splitWords(document.querySelector('.hero-sub'));
      var s2Words = splitWords(document.querySelector('.s2-text'));

      /* Hero load timeline: topbar pill drops in, the gold
         highlight sweeps on, the subhead cascades word by word,
         the button pops, tiles pop. Headline lines are NOT in
         this timeline (see note below) — they are fully visible
         on first paint. */
      /* Hero headline: deliberately NOT animated on load. The old
         mask-rise (.from yPercent 110 inside an overflow-hidden
         mask) meant that at first paint / mid-load the headline
         was literally half inside its own mask — top halves
         visible, lower half covered, yellow line below. With no
         load tween on these lines, the headline renders complete
         on first paint and can never be half-clipped by its mask,
         on load, reload, or at rest. The highlight sweep below
         still animates, over an already-full gold base. */
      var heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      heroTl
        .from('#site-topbar .topbar-pill', { y: -16, opacity: 0, duration: 0.8, clearProps: 'transform,opacity' }, 0)
        .fromTo('.hero-highlight', { backgroundSize: '0% 100%' }, { backgroundSize: '100% 100%', duration: 0.8, ease: 'power2.out' }, 0.9)
        .from(heroWords, { yPercent: 110, duration: 0.7, stagger: 0.03, clearProps: 'transform' }, 0.7)
        .from('.hero-cta', { y: 16, scale: 0.96, opacity: 0, duration: 0.8, ease: 'back.out(1.2)', clearProps: 'transform,opacity' }, 1.0)
        .from('.iso-wrap, .mob-tile', { opacity: 0, scale: 0.85, duration: 0.7, stagger: 0.08, ease: 'back.out(1.2)' }, 0.9);

      /* Tile float: gentle, slow, staggered, transform only, on the
         wrappers — the logo artwork itself is never animated. */
      document.querySelectorAll('.iso-wrap, .mob-tile').forEach(function (el, i) {
        gsap.to(el, { y: -8, duration: 2.2 + (i % 3) * 0.3, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: 1.6 + (i % 6) * 0.15 });
      });

      /* Desktop mouse tilt on the perspective stage. */
      var isoStage = document.querySelector('.iso-stage');
      if (isoStage && window.matchMedia('(pointer: fine)').matches && window.innerWidth >= 1024) {
        gsap.set(isoStage, { transformPerspective: 900 });
        var tiltY = gsap.quickTo(isoStage, 'rotationY', { duration: 0.6, ease: 'power3.out' });
        var tiltX = gsap.quickTo(isoStage, 'rotationX', { duration: 0.6, ease: 'power3.out' });
        var heroSection = document.getElementById('section-1');
        heroSection.addEventListener('mousemove', function (e) {
          var r = heroSection.getBoundingClientRect();
          tiltY(((e.clientX - r.left) / r.width - 0.5) * 6);
          tiltX(-((e.clientY - r.top) / r.height - 0.5) * 6);
        });
        heroSection.addEventListener('mouseleave', function () { tiltY(0); tiltX(0); });
      }

      /* Section 2 reveal, SCRUBBED: progress is tied directly to
         scroll position, so scrolling down plays it forward and
         scrolling up reverses it along the exact same path — no
         replay, no snap, no stepped replay. Reveal completes while
         the section is entering (top 90% -> top 45%), before it is
         centred. Defaults ease 'none' so scrub progress maps 1:1;
         pops keep their own back.out ease. */
      gsap.timeline({
        scrollTrigger: { trigger: '#section-2', start: 'top 90%', end: 'top 45%', scrub: 1 },
        defaults: { ease: 'none' },
      })
        .from('#section-2 .reveal-line', { yPercent: 110, duration: 0.9, stagger: 0.12 })
        .from(s2Words, { yPercent: 110, duration: 0.7, stagger: 0.015 }, '-=0.5')
        .from('.s2-centre', { opacity: 0, duration: 0.7 }, '-=0.5')
        .from('.s2-centre svg', { opacity: 0, duration: 0.8 }, '<')
        .from('.orbit-badge', { scale: 0.8, opacity: 0, xPercent: -50, yPercent: -50, duration: 0.7, stagger: 0.08, ease: 'back.out(1.2)' }, '-=0.4');

      /* Orbit: the badge ring revolves slowly, each badge logo
         counter-rotates so every logo stays upright. The centre
         mark never rotates. These loops keep running; they are
         never reversed by scrolling. */
      gsap.to('.orbit-ring', { rotation: 360, duration: 24, repeat: -1, ease: 'none' });
      gsap.to('.orbit-upright', { rotation: -360, duration: 24, repeat: -1, ease: 'none' });
      /* Centre glow: a slow breathing scale on the mark only. */
      gsap.to('.s2-centre svg', { scale: 1.03, duration: 2.4, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: 2.5, transformOrigin: '50% 50%' });

      /* Section 4 reveal, SCRUBBED (same forward/backward rule as
         section 2: top 90% -> top 45%, no stepped replay). */
      gsap.timeline({
        scrollTrigger: { trigger: '#section-5', start: 'top 90%', end: 'top 45%', scrub: 1 },
        defaults: { ease: 'none' },
      })
        .from('#section-4 .reveal-line', { yPercent: 110, duration: 0.9, stagger: 0.12 })
        .fromTo('#section-4 .community-highlight', { backgroundSize: '0% 100%' }, { backgroundSize: '100% 100%', duration: 0.8, ease: 'power2.out' }, '-=0.3');

      /* Section 3 reveal, SCRUBBED fade+rise only (same calm
         vocabulary as sections 5–6: opacity + y, no scale, no
         pop, no bounce, no mask, so nothing clips and scrolling
         back returns it along the same path. Trigger top 90% ->
         top 45%, scrub 1, ease none. */
      gsap.timeline({
        scrollTrigger: { trigger: '#section-3', start: 'top 90%', end: 'top 45%', scrub: 1 },
        defaults: { ease: 'none' },
      })
        .from('#section-3 h2', { opacity: 0, y: 24, duration: 0.7 })
        .from('#section-3 > div > p', { opacity: 0, y: 24, duration: 0.7 }, '-=0.3')
        .from('#section-3 .s3-panel', { opacity: 0, y: 24, duration: 0.9 }, '-=0.3');

      /* Section 5 reveal, SCRUBBED (same forward/backward rule:
         top 90% -> top 45%, no stepped replay). Calm fade+rise
         only: no pop, no scale, no bounce, no masked-line rise,
         so scrolling back up genuinely returns pill + heading
         to opacity 0 / y 24 (hidden) along the same path. The
         reveal-mask wrappers are animated, not the inner
         reveal-line spans, so nothing clips through a mask. */
      gsap.timeline({
        scrollTrigger: { trigger: '#section-5', start: 'top 90%', end: 'top 45%', scrub: 1 },
        defaults: { ease: 'none' },
      })
        .from('.s4-pill', { opacity: 0, y: 24, duration: 0.7 })
        .from('#section-5 .reveal-mask', { opacity: 0, y: 24, duration: 0.9, stagger: 0.12 }, '-=0.3');

      /* Section 6 footer reveal, SCRUBBED fade+rise only (same
         calm vocabulary as section 4: opacity + y, no scale, no
         pop, no bounce, no mask clipping — the footer children
         are plain blocks, not masked lines). Trigger completes
         early on purpose: start when the footer top reaches 95%
         of the viewport, end when it reaches 75%. At maximum
         scroll the footer top sits at viewport height minus
         footer height; the footer is ~450px+ tall, so even on a
         tall 1440px viewport its top rests near 69% — inside the
         75% end — so the scrub always finishes and the footer is
         fully visible at the very bottom of the page, and
         scrolling back up returns it to hidden along the same
         path. From-tweens only, so without JS it is fully
         visible and native anchors still work. */
      gsap.timeline({
        scrollTrigger: { trigger: '#section-6', start: 'top 95%', end: 'top 75%', scrub: 1 },
        defaults: { ease: 'none' },
      })
        .from('.s5-content > *', { opacity: 0, y: 24, duration: 0.9, stagger: 0.12 });

      /* In-page anchors: smooth Lenis scroll to sections 2–5
         from the footer pills. Only section anchors are
         intercepted; without this module, native anchor jumps
         still work (scroll-padding-top: 84px clears the topbar).
         Topbar '#' placeholders are deliberately untouched. */
      document.querySelectorAll('a[href^="#section-"]').forEach(function (a) {
        a.addEventListener('click', function (ev) {
          var target = document.querySelector(a.getAttribute('href'));
          if (!target) return;
          ev.preventDefault();
          lenis.scrollTo(target, { duration: 1.2 });
        });
      });

      /* Scroll parallax, scrubbed, so scrolling back moves
         everything back along the same path. Applied to parent
         wrappers only, never to elements the reveal timelines
         animate, so the two never fight. Transform only. */
      gsap.to('.hero-copy', { y: -20, ease: 'none', scrollTrigger: { trigger: '#section-1', start: 'top top', end: 'bottom top', scrub: 1 } });
      gsap.to('.hero-copy', { opacity: 0.25, ease: 'none', scrollTrigger: { trigger: '#section-1', start: 'top top', end: 'bottom top', scrub: 1 } });
      gsap.to('.iso-stage, .mob-grid', { y: 30, ease: 'none', scrollTrigger: { trigger: '#section-1', start: 'top top', end: 'bottom top', scrub: 1 } });
      gsap.to('.s2-grid > div:first-child', { y: -25, ease: 'none', scrollTrigger: { trigger: '#section-2', start: 'top bottom', end: 'bottom top', scrub: 1 } });
      gsap.to('.s2-orbit', { y: 15, ease: 'none', scrollTrigger: { trigger: '#section-2', start: 'top bottom', end: 'bottom top', scrub: 1 } });
      /* No parallax on the section-4 panel: its section background
         is now white, so moving the panel up would expose a white
         strip between it and section 5. Section 5's panel keeps
         its parallax — black on black, so the join stays seamless. */
      gsap.to('#section-5 .dark-panel', { y: -20, ease: 'none', scrollTrigger: { trigger: '#section-4', start: 'top bottom', end: 'bottom top', scrub: 1 } });

      window.addEventListener('load', function () { ScrollTrigger.refresh(); });
    }
  </script>
