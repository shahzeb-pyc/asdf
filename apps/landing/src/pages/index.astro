      <!-- Desktop platform tiles: a perspective floor of white diamond
           tiles at varying depths. Each logo is a separate layer, a
           sibling of its tilted tile, centred over it upright and
           undistorted. -->
      <div class="iso-stage pointer-events-none relative mx-auto mt-8 hidden h-[280px] w-full max-w-[1100px] lg:block" aria-hidden="true">
        <span class="iso-wrap absolute bottom-[84px] left-[-14px] z-[3] h-[118px] w-[118px]">
